#!/bin/sh
# Emit an Authorization header only when an agent key is available.
# Emitting {} leaves the header absent, so the server 401s and the host runs
# OAuth — a static headers.Authorization would disable OAuth entirely.
set -eu
key=${AMBI_AGENT_KEY:-}
if [ -z "$key" ] && [ -r "$HOME/.ambi/config.json" ]; then
  key=$(sed -n 's/.*"authToken"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$HOME/.ambi/config.json" 2>/dev/null | head -1)
fi
case "${key:-}" in
  ak_*) printf '{"Authorization":"Bearer %s"}\n' "$key" ;;
  *)    printf '{}\n' ;;
esac
