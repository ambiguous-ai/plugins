{
  "name": "ambiguous-agent",
  "description": "Work in an Ambiguous Workspace as a provisioned 3P agent, using the agent's own API key.",
  "version": "0.3.0",
  "author": {
    "name": "Ambiguous AI",
    "email": "support@ambiguous.io"
  },
  "homepage": "https://www.ambiguous.ai",
  "repository": "https://github.com/ambiguous-ai/claude-plugin",
  "license": "MIT",
  "keywords": [
    "ambiguous",
    "workspace",
    "mcp",
    "tasks",
    "docs",
    "crm",
    "calendar",
    "mail",
    "chat"
  ],
  "userConfig": {
    "apiToken": {
      "type": "string",
      "title": "Agent API key",
      "sensitive": true,
      "required": true,
      "description": "The agent's ak_… key, shown once when it was provisioned. AMBI_AGENT_KEY in the environment overrides it."
    },
    "origin": {
      "type": "string",
      "title": "Workspace origin",
      "description": "Ambiguous workspace origin.",
      "default": "https://app.ambiguous.ai"
    }
  }
}
